# Generate actual local secrets with: node local/setup.mjs
LOCAL_API_URL=http://127.0.0.1:54321
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=54321
LOCAL_SERVICE_KEY=
PUBLIC_APP_URL=http://localhost:3000
LOCAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
SEED_ADMIN_EMAIL=admin@cleaning.local
SEED_ADMIN_PASSWORD=

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# apps/admin/.env.local (generated by setup)
NEXT_PUBLIC_LOCAL_API_URL=http://127.0.0.1:54321

# apps/mobile/.env.local (use the computer LAN IP for a physical phone)
EXPO_PUBLIC_LOCAL_API_URL=http://127.0.0.1:54321
EXPO_PUBLIC_REGISTRATION_API_URL=http://127.0.0.1:3000/api/register
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_MAP_PROVIDER=google
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_2GIS_MAPGL_KEY=

# Optional LAN address override for mobile:local
# LOCAL_MOBILE_HOST=192.168.1.42
# LOCAL_PUBLIC_API_URL=http://192.168.1.42:54321
