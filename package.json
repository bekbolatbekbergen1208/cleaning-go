{
  "name": "cleaning-go",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:mobile": "corepack pnpm --filter @cleaning-go/mobile start",
    "dev:admin": "corepack pnpm --filter @cleaning-go/admin dev",
    "admin:create": "node --env-file=.env.local local/create-admin.mjs",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "node --test local/tests/*.test.mjs scripts/tests/*.test.mjs && corepack pnpm --filter @cleaning-go/validation test",
    "lint": "corepack pnpm -r --if-present lint",
    "format": "prettier --write .",
    "test:tracking": "node --test scripts/tests/*.test.mjs",
    "local:setup": "node local/setup.mjs",
    "dev:api": "node --env-file=.env.local local/server.mjs",
    "test:local": "node --test local/tests/*.test.mjs",
    "mobile:prepare": "node --env-file=.env.local local/mobile.mjs --prepare",
    "mobile:local": "node --env-file=.env.local local/mobile.mjs",
    "test:web": "node scripts/web-security.mjs",
    "test:functional": "node scripts/web-functional.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4",
      "postcss@<8.5.23": "8.5.23",
      "sharp@<0.35.5": "0.35.5",
      "uuid@<11.1.1": "11.1.1",
      "nanoid@<3.3.18": "3.3.18",
      "decode-uri-component@<0.5.1": "0.5.1",
      "@xmldom/xmldom@>=0.7.0 <0.9.0": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "js-yaml@>=3 <4": "3.15.2",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "image-size@>=0.6.3 <2.0.3": "2.0.3",
      "undici@<7": "6.29.1",
      "undici@>=7 <7.30.1": "7.30.1",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "brace-expansion@>=4 <5.0.12": "5.0.12",
      "source-map-js@<1.2.2": "1.2.2",
      "compression@<1.8.2": "1.8.2",
      "shell-quote@<1.11.0": "1.11.0",
      "node-forge@<1.4.3": "1.4.3",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "glob@>=9 <14.0.2": "14.0.2",
      "minimatch@>=7 <11.0.1": "11.0.1",
      "zod@<4.6.6": "4.6.6",
      "vite@>=7 <7.3.7": "7.3.7"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
      "metro@0.82.5": "patches/metro@0.82.5.patch"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14"
  }
}
